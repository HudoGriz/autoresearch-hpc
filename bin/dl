#!/usr/bin/env bash
# discovery-loop — command dispatcher.
set -euo pipefail
# Resolve through a symlink without GNU readlink -f (absent on macOS/BSD).
_dl_self="${BASH_SOURCE[0]}"
while [ -L "$_dl_self" ]; do
  _dl_link=$(ls -ld -- "$_dl_self" | sed 's/.* -> //')
  case "$_dl_link" in /*) _dl_self="$_dl_link" ;; *) _dl_self="$(dirname "$_dl_self")/$_dl_link" ;; esac
done
DL_HOME="${DL_HOME:-$(cd "$(dirname "$_dl_self")/.." && pwd)}"
export DL_HOME

usage() {
  cat <<'USAGE'
dl — automated discovery loop

  dl init [dir]                 create a project (ledger, config, dirs)
  dl claim  -t TITLE            atomically claim the next iteration number
  dl new    -n N                scaffold iteration N from the pre-declaration template
  dl arm    {new|gate|fate|list} parallel sub-analyses within one iteration
  dl gate   predeclare -n N     check the pre-declaration, then freeze its hash
  dl gate   results    -n N     check results against the frozen pre-declaration
  dl gate   rules      <file>   check a document against the standing rules
  dl ask    --role R -n N       cross-check with a foreign harness
  dl verify {new|gate|list}     re-examine an object an iteration produced
  dl dag    {init|check|freeze} reconstruct the path a result took
  dl replicate [run|report]     N agents re-implement from the DAG, blind to the code
  dl run    IMAGE -- CMD...     run a command in a pinned container
  dl submit SCRIPT -n NAME      submit a job through the configured scheduler
  dl guard  PATH...             assert paths are writable under the project
  dl ledger [render|check]      maintain the project record
  dl status                     show iterations, claims and gate state
  dl doctor                     check the environment and configuration
  dl next                       what to do next, and why

Run `dl <command> --help` for detail.
USAGE
}

[ $# -ge 1 ] || { usage; exit 2; }
cmd="$1"; shift
case "$cmd" in
  -h|--help|help) usage ;;
  -V|--version|version)
    printf 'discovery-loop %s (protocol %s)\n' \
      "$(cat "$DL_HOME/VERSION" 2>/dev/null || echo unknown)" \
      "$(sed -n 's/^# The discovery-loop protocol, v//p' "$DL_HOME/PROTOCOL.md" 2>/dev/null || echo unknown)"
    ;;
  init|claim|new|arm|gate|ask|dag|replicate|verify|run|submit|guard|ledger|status|doctor|next)
    exec "$DL_HOME/bin/dl-$cmd" "$@" ;;
  *) printf 'dl: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
