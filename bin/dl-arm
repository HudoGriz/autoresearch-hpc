#!/usr/bin/env bash
# Arms — parallel sub-analyses within one iteration.
#
# An iteration answers one question; an arm is one route to the answer. Arms
# fail independently, and an arm that was dropped because it did not work is a
# result: without it, the surviving arms look like the whole design.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${DL_HOME:?}/lib/common.sh"

sub="${1:-list}"; shift || true
case "$sub" in -h|--help) echo 'usage: dl arm {new|gate|fate|list} -n N [-a ARM] [-t TITLE] [-f FATE]'; exit 0 ;; esac

n=""; arm=""; title=""; fate=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="$2"; shift 2 ;;
    -a|--arm)       arm="$2"; shift 2 ;;
    -t|--title)     title="$2"; shift 2 ;;
    -f|--fate)      fate="$2"; shift 2 ;;
    *) dl_die "unexpected argument: $1" ;;
  esac
done
[ -n "$n" ] || dl_die "which iteration? dl arm $sub -n N"
dl_load_project
dir="$DL_ITERS/iteration$n"
[ -d "$dir" ] || dl_die "no iteration $n"
armsdir="$dir/arms"

VALID_FATES="CONCLUDED NULL INFEASIBLE KILLED_BY_CONTROL ABANDONED"

case "$sub" in
  new)
    [ -n "$arm" ] || dl_die "which arm? dl arm new -n $n -a A -t 'title'"
    case "$arm" in */*|.*|"") dl_die "arm id must be a single path segment: $arm" ;; esac
    [ -f "$dir/PREDECLARATION.sha256" ] \
      || dl_die "iteration $n is not pre-declared yet — arms specialise a pre-declaration, they do not replace it"
    mkdir -p "$armsdir"
    a="$armsdir/$arm"
    mkdir "$a" 2>/dev/null || dl_die "arm $arm already exists"
    mkdir -p "$a"/{scripts,results,logs}
    sed -e "s|{{N}}|$n|g" -e "s|{{ARM}}|$arm|g" -e "s|{{DATE}}|$(dl_today)|g" \
        -e "s|{{TITLE}}|${title:-<state what this arm tests>}|g" \
        "$DL_HOME/templates/iteration/ARM.md" > "$a/README.md"
    printf 'wrote %s\n\nComplete it, then:  dl arm gate -n %s -a %s\n' "${a#"$DL_ROOT"/}/README.md" "$n" "$arm"
    ;;

  gate)
    [ -n "$arm" ] || dl_die "which arm?"
    a="$armsdir/$arm"; r="$a/README.md"
    [ -f "$r" ] || dl_die "no arm $arm in iteration $n"
    printf 'gate: iteration %s arm %s\n' "$n" "$arm"
    fails=0
    [ -n "$(find "$a/results" -type f 2>/dev/null | head -1)" ] \
      && { dl_fail "results/ already populated"; fails=$((fails+1)); } || dl_ok "results/ is empty"
    for sec in "What this arm tests" "Acceptance criteria" "Negative control" "Fate"; do
      grep -qiF "$sec" "$r" && dl_ok "section: $sec" || { dl_fail "section missing: $sec"; fails=$((fails+1)); }
    done
    grep -qE '^<|\{\{[A-Z_]+\}\}|\bTODO\b|\bTBD\b' "$r" \
      && { dl_fail "template placeholders remain"; fails=$((fails+1)); } || dl_ok "no placeholders remain"
    [ "$fails" -gt 0 ] && { printf '\ngate FAILED (%s). Nothing frozen.\n' "$fails" >&2; exit 1; }
    dl_sha256 "$r" > "$a/PREDECLARATION.sha256"
    printf '%s\n' "$(dl_now)" >> "$a/PREDECLARATION.sha256"
    printf '\ngate PASSED. Arm %s frozen.\n' "$arm"
    ;;

  fate)
    [ -n "$arm" ] || dl_die "which arm?"
    a="$armsdir/$arm"; r="$a/README.md"
    [ -f "$r" ] || dl_die "no arm $arm in iteration $n"
    [ -n "$fate" ] || dl_die "which fate? one of: $VALID_FATES"
    case " $VALID_FATES " in *" $fate "*) ;; *) dl_die "invalid fate '$fate'. One of: $VALID_FATES" ;; esac
    printf '%s\t%s\n' "$fate" "$(dl_now)" > "$a/FATE"
    printf 'iteration %s arm %s: %s\n' "$n" "$arm" "$fate"
    case "$fate" in
      INFEASIBLE|KILLED_BY_CONTROL|ABANDONED)
        printf '\nThis is a REPORTABLE result, not a dropped arm. State it in the\n'
        printf 'iteration report: an arm removed quietly makes the survivors look\n'
        printf 'like the whole design.\n' ;;
    esac
    ;;

  list)
    [ -d "$armsdir" ] || { printf '(iteration %s has no arms)\n' "$n"; exit 0; }
    printf '%-10s %-11s %-20s %s\n' ARM PREDECL FATE TITLE
    printf '%-10s %-11s %-20s %s\n' ---------- ----------- -------------------- -----
    for a in "$armsdir"/*/; do
      [ -d "$a" ] || continue
      id=$(basename "$a")
      if [ -f "$a/PREDECLARATION.sha256" ]; then
        [ "$(head -1 "$a/PREDECLARATION.sha256")" = "$(dl_sha256 "$a/README.md" 2>/dev/null)" ] \
          && pre=frozen || pre=ALTERED
      else pre=draft; fi
      f=$(cut -f1 "$a/FATE" 2>/dev/null || echo PLANNED)
      t=$(sed -n '1s/.*— //p' "$a/README.md" 2>/dev/null | head -1)
      printf '%-10s %-11s %-20s %s\n' "$id" "$pre" "$f" "${t:0:40}"
    done
    ;;
  *) dl_die "unknown: $sub" ;;
esac
