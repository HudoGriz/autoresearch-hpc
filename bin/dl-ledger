#!/usr/bin/env bash
# Maintain the project record.
#
#   dl ledger check   — is the ledger consistent with what is on disk?
#   dl ledger render  — regenerate the status table from the iteration record
set -euo pipefail
# shellcheck source=lib/common.sh
. "${DL_HOME:?}/lib/common.sh"
sub="${1:-check}"
case "$sub" in -h|--help) echo 'usage: dl ledger {check|render}'; exit 0 ;; esac
dl_load_project
[ -f "$DL_LEDGER" ] || dl_die "no ledger at $DL_LEDGER"

iters=$(find "$DL_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
        | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p' | sort -n)

build_table() {
  printf '<!-- dl:status:begin — generated by `dl ledger render`; do not edit by hand -->\n\n'
  printf '| It. | Claimed by | Pre-declaration | Results | Cross-check | Subject |\n'
  printf '|---|---|---|---|---|---|\n'
  for d in $iters; do
    dir="$DL_ITERS/iteration$d"
    agent=$(sed -n 's/.*"declared_agent"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1)
    title=$(sed -n 's/.*"title"[ ]*:[ ]*"\(.*\)",\{0,1\}$/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1)
    if [ -f "$dir/PREDECLARATION.sha256" ]; then
      [ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(dl_sha256 "$dir/README.md" 2>/dev/null)" ] \
        && pre='frozen' || pre='**ALTERED**'
    elif [ -f "$dir/README.md" ]; then pre=draft; else pre='—'; fi
    [ -f "$dir/results/report/iteration${d}_report.md" ] && res=report || res='—'
    find "$dir" -name 'CROSSCHECK_*.md' -type f 2>/dev/null | grep -q . && xc=yes || xc='—'
    printf '| %s | %s | %s | %s | %s | %s |\n' "$d" "${agent:-—}" "$pre" "$res" "$xc" "${title:-—}"
  done
  printf '\n<!-- dl:status:end -->\n'
}

case "$sub" in
  render)
    tmp=$(mktemp); table=$(mktemp); build_table > "$table"
    if grep -q 'dl:status:begin' "$DL_LEDGER"; then
      awk -v f="$table" '
        /dl:status:begin/ { while ((getline l < f) > 0) print l; skip=1; next }
        /dl:status:end/   { skip=0; next }
        !skip { print }' "$DL_LEDGER" > "$tmp"
    else
      { cat "$DL_LEDGER"; printf '\n'; cat "$table"; } > "$tmp"
    fi
    mv "$tmp" "$DL_LEDGER"; rm -f "$table"
    printf 'rendered status table into %s\n' "${DL_LEDGER#"$DL_ROOT"/}"
    ;;
  check)
    fails=0
    for d in $iters; do
      dir="$DL_ITERS/iteration$d"
      if [ -f "$dir/PREDECLARATION.sha256" ] && [ -f "$dir/README.md" ]; then
        if [ "$(head -1 "$dir/PREDECLARATION.sha256")" != "$(dl_sha256 "$dir/README.md")" ]; then
          dl_fail "iteration $d — README.md altered after its pre-declaration was frozen"
          fails=$((fails+1)); continue
        fi
      fi
      if [ -f "$dir/results/report/iteration${d}_report.md" ] && [ ! -f "$dir/PREDECLARATION.sha256" ]; then
        dl_fail "iteration $d — has a report but was never pre-declared"; fails=$((fails+1)); continue
      fi
      grep -q "iteration $d\b\|iteration${d}\b\|^| $d |" "$DL_LEDGER" 2>/dev/null \
        && dl_ok "iteration $d" || { dl_fail "iteration $d — absent from the ledger"; fails=$((fails+1)); }
    done
    [ "$fails" -gt 0 ] && { printf '\n%s ledger problem(s).\n' "$fails" >&2; exit 1; }
    printf '\nLedger consistent with %s iteration(s) on disk.\n' "$(printf '%s\n' $iters | grep -c . || echo 0)"
    ;;
  *) dl_die "unknown: $sub" ;;
esac
