#!/usr/bin/env bash
# The operator's sign-off on a concluded confirmatory iteration: a person, not an agent, says the
# finding may go into a report. Reviews come from other models; this is the human step.
#
#   arh sign -n N [--note TEXT]   sign iteration N (refused from inside an agent session)
#   arh sign list                 every sign-off, and whether the evidence still matches it
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
n=""; note=""
case "${1-}" in
  -h|--help|"") sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
  list) arh_load_project; exec python3 "$ARH_HOME/lib/signoff.py" list "$ARH_ITERS" ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="$2"; shift 2 ;;
    --note) note="$2"; shift 2 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
case "$n" in ""|*[!0-9]*) arh_die "which iteration? arh sign -n N" ;; esac
arh_load_project
dir="$ARH_ITERS/iteration$n"
[ -d "$dir" ] || arh_die "no iteration $n"
exec python3 "$ARH_HOME/lib/signoff.py" sign "$dir" "$note"
