#!/usr/bin/env bash
# Scaffold an iteration's pre-declaration from the template.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

n=""; title=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--iteration) n="$2"; shift 2 ;;
    -t|--title)     title="$2"; shift 2 ;;
    -h|--help) echo 'usage: arh new -n N [-t TITLE]'; exit 0 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
[ -n "$n" ] || arh_die "which iteration? arh new -n N"

arh_load_project
dir="$ARH_ITERS/iteration$n"
[ -d "$dir" ] || arh_die "iteration $n is not claimed. Run: arh claim -t '...'"
[ -f "$dir/README.md" ] && arh_die "$dir/README.md already exists — pre-declarations are never rewritten"

if [ -z "$title" ] && [ -f "$dir/CLAIM.json" ]; then
  title=$(sed -n 's/.*"title"[ ]*:[ ]*"\(.*\)",\{0,1\}$/\1/p' "$dir/CLAIM.json" | head -1)
fi

rules=$(arh_config_get "$ARH_PROJ" rules "")
rule_lines=""
for r in $rules; do
  [ -f "$ARH_ROOT/rules/$r.md" ] || continue
  desc=$(sed -n '1s/^# *//p' "$ARH_ROOT/rules/$r.md")
  rule_lines="${rule_lines}- \`$r\` — ${desc}"$'\n'
done

tier=$(arh_tier "$dir")
template="$ARH_HOME/templates/iteration/README.md"
[ "$tier" = confirmatory ] || template="$ARH_HOME/templates/iteration/EXPLORE.md"
sed -e "s|{{N}}|$n|g" \
    -e "s|{{TITLE}}|${title:-<state the question>}|g" \
    -e "s|{{DATE}}|$(arh_today)|g" \
    -e "s|{{AGENT}}|$(arh_agent_name)|g" \
    "$template" > "$dir/README.md"
# A promoted variant carries the size of the search it won, so the report can state it.
promotes=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("promotes", ""))' "$dir/CLAIM.json" 2>/dev/null || true)
if [ -n "$promotes" ]; then
  tried=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import attempts
print(len(attempts.journal(sys.argv[2])))' "$ARH_HOME/lib" "$ARH_ITERS/iteration$promotes")
  awk -v p="$promotes" -v k="$tried" 'NR==4 { print; print ""; printf "**Promotes exploratory iteration %s**, whose journal records %s attempt(s). The quantity below is measured on data that choice was not made on (say which in section 3); the exploratory numbers are not reported as findings.\n", p, k; next } { print }' \
    "$dir/README.md" > "$dir/README.md.new" && mv "$dir/README.md.new" "$dir/README.md"
fi

if [ -n "$rule_lines" ]; then
  tmp=$(mktemp); printf '%s' "$rule_lines" > "$tmp"
  awk -v f="$tmp" '/{{RULES}}/ { while ((getline l < f) > 0) print l; next } { print }' \
      "$dir/README.md" > "$dir/README.md.new" && mv "$dir/README.md.new" "$dir/README.md"
  rm -f "$tmp"
else
  sed 's/{{RULES}}//' "$dir/README.md" > "$dir/README.md.new"
  mv "$dir/README.md.new" "$dir/README.md"
fi

arh_lease_touch "$dir" "arh new"
printf 'wrote %s\n' "$dir/README.md"
if [ "$tier" = exploratory ]; then
  printf '\nWrite the aim and the selection rule, then run attempts with arh submit and add a journal row for each.\n'
  printf 'Finish with a short report and arh gate results -n %s. Promote a winner with arh claim --promotes %s.\n' "$n" "$n"
else
  printf '\nComplete every section, then:  arh gate predeclare -n %s\n' "$n"
  printf 'No result may be recorded until that gate passes and freezes the hash.\n'
fi
