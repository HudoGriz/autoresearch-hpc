#!/usr/bin/env bash
# Atomically claim the next iteration number.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

title=""; agent=""; question=""; continues=""; tier=confirmatory; promotes=""; roles=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--title) title="$2"; shift 2 ;;
    -a|--agent) agent="$2"; shift 2 ;;
    -q|--question) question="$2"; shift 2 ;;
    --continues) continues="$2"; shift 2 ;;
    --explore) tier=exploratory; shift ;;
    --promotes) promotes="$2"; shift 2 ;;
    --worker|--worker-fallback|--reviewer|--reviewer-fallback|--on-limit)
                roles+=("${1#--}=$2"); shift 2 ;;
    --set)      roles+=("$2"); shift 2 ;;
    -h|--help)  echo 'usage: arh claim -t TITLE [-a AGENT] [--question ID | --continues N] [--explore | --promotes N]
                 [--worker H] [--reviewer H] [--on-limit fallback|wait|stop] [--set KEY=VALUE]
--question ID: the question this iteration addresses (letters, digits, . _ -); iterations that share
  one are counted as attempts at it in the ledger. --continues N: the question iteration N addressed.
  Without either, the iteration is its own question (qN).
--explore: an exploratory iteration. No freeze and no review are required; sealed inputs stay sealed,
  and its numbers are not findings. Record every attempt in its README journal.
--promotes N: a confirmatory iteration that re-measures the variant exploratory iteration N chose,
  on data the choice was not made on. It takes the question of iteration N.
--worker, --reviewer (and --worker-fallback, --reviewer-fallback): the harness for that
  role in this iteration only; unset roles use .arh/config/harnesses.md. --on-limit: what a dispatched
  worker does at its usage limit. --set KEY=VALUE: any other harnesses.md key, for this iteration only.
  They are written to iterationN/harnesses.md and are part of the review terms; arh roles changes them later.'; exit 0 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
arh_load_project
# A promotion re-measures N's variant, so its title defaults to N's (field feedback #148).
if [ -z "$title" ] && [ -n "$promotes" ] && [ -f "$ARH_ITERS/iteration$promotes/CLAIM.json" ]; then
  title="Promotion of iteration $promotes: $(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("title", ""))' \
    "$ARH_ITERS/iteration$promotes/CLAIM.json")"
fi
[ -n "$title" ] || arh_die "a title is required: arh claim -t 'the question'"
if [ -n "$promotes" ]; then
  [ "$tier" = confirmatory ] || arh_die "--promotes makes a confirmatory iteration; drop --explore"
  [ -z "$continues$question" ] || arh_die "--promotes takes the question of the iteration it promotes"
  case "$promotes" in ""|*[!0-9]*) arh_die "--promotes takes an iteration number" ;; esac
  [ "$(arh_tier "$ARH_ITERS/iteration$promotes")" = exploratory ] \
    || arh_die "iteration $promotes is not an exploratory iteration (arh claim --explore)"
  continues=$promotes
fi
# Which question this is another attempt at: the ledger counts every iteration on it, concluded or not.
if [ -n "$continues" ]; then
  [ -z "$question" ] || arh_die "give --question or --continues, not both"
  case "$continues" in ""|*[!0-9]*) arh_die "--continues takes an iteration number" ;; esac
  [ -f "$ARH_ITERS/iteration$continues/CLAIM.json" ] || arh_die "no claimed iteration $continues to continue"
  question=$(python3 "$ARH_HOME/lib/attempts.py" question "$ARH_ITERS/iteration$continues")
fi
[ -z "$question" ] || python3 "$ARH_HOME/lib/attempts.py" valid-id "$question" \
  || arh_die "invalid question id '$question': letters, digits, '.', '_' and '-', at most 64 characters"
# Who claimed this iteration. The configured producer is operator-owned and carries the
# model and account a lane pinned into its name; ARH_AGENT and the harness markers are set
# by the session itself and lose that. So the configured producer wins over both, `-a`
# wins over everything, and what the session reported is recorded alongside either way.
inferred=$(arh_agent_name); inferred_from=$(arh_agent_source)
producer=$(arh_config_get "$ARH_HARN" producer "")
if [ -n "$agent" ]; then
  agent_source='claim --agent'
elif [ -n "$producer" ] && [ "$producer" != "$inferred" ] && [ "$inferred_from" != USER ]; then
  arh_warn_agent_mismatch
  arh_warn "recording '$producer' as this iteration's agent; '$inferred' is kept as inferred_agent"
  agent=$producer; agent_source='config:producer'
else
  agent=$inferred; agent_source=$inferred_from
fi
mkdir -p "$ARH_ITERS"

n=$(
  { find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null \
      | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p'
    awk -F'\t' 'NR>1 && $1 ~ /^[0-9]+$/ {print $1}' "$ARH_REGISTRY" 2>/dev/null
  } | sort -n | tail -1
)
n=$(( ${n:-0} + 1 ))

dir=""
for _ in $(seq 1 100); do
  if mkdir "$ARH_ITERS/iteration$n" 2>/dev/null; then dir="$ARH_ITERS/iteration$n"; break; fi
  n=$((n + 1))
done
[ -n "$dir" ] || arh_die "could not claim an iteration number after 100 attempts"

# The review terms the iteration is claimed under. A copy, so that a later change can be shown and
# not only detected; its hash in CLAIM.json is what arh ask and arh gate results compare against.
terms=""
[ ${#roles[@]} -eq 0 ] || arh_set_iter_harn "$dir" "${roles[@]}" || { rmdir "$dir" 2>/dev/null; exit 1; }
if [ -f "$ARH_HARN" ]; then
  mkdir -p "$dir/metadata"
  cp "$(arh_iter_harn "$dir")" "$dir/metadata/harnesses.claimed.md"
  terms=$(arh_sha256 "$dir/metadata/harnesses.claimed.md")
fi

# What the claim was made knowing: the hashes of DIRECTIVES.md, GOTCHAS.md and the site's shared gotchas,
# so a later session can see whether the directives changed under the iteration.
knowledge=$(python3 "$ARH_HOME/lib/project.py" knowledge-hashes "$ARH_ROOT")

# The review policy the iteration is judged by. project.md is the producer's to edit, so the gate
# reads these values from the claim: relaxing unsound_review mid-iteration does not relax it.
policy=$(python3 -c 'import json, sys
print(json.dumps(dict(zip(("require_crosscheck", "review_response", "unsound_review"), sys.argv[1:]))))' \
  "$(arh_config_get "$ARH_PROJ" require_crosscheck true)" "$(arh_config_get "$ARH_PROJ" review_response require)" \
  "$(arh_config_get "$ARH_PROJ" unsound_review require-adjudication)")

promotes_field=""; [ -z "$promotes" ] || promotes_field=$(printf ',\n  "promotes": %s' "$promotes")
cat > "$dir/CLAIM.json" <<EOF
{
  "iteration": $n,
  "agent": "$agent",
  "agent_source": "$agent_source",
  "declared_agent": "$agent",
  "inferred_agent": "$inferred",
  "inferred_from": "$inferred_from",
  "claimed": "$(arh_now)",
  "title": $(printf '%s' "$title" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'),
  "question": "${question:-q$n}",
  "status": "CLAIMED",
  "session": "${ARH_SESSION:-}",
  "harness_config_sha256": "$terms",
  "knowledge_sha256": $knowledge,
  "review_policy": $policy,
  "freeze_journal": true,
  "tier": "$tier"$promotes_field
}
EOF

_append_row() { printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$agent" "$(arh_now)" CLAIMED "$title" >> "$ARH_REGISTRY"; }
if command -v flock >/dev/null 2>&1; then
  exec 9>>"$ARH_REGISTRY.lock"; flock 9; _append_row; exec 9>&-
else
  until mkdir "$ARH_REGISTRY.lock.d" 2>/dev/null; do sleep 0.2; done
  _append_row; rmdir "$ARH_REGISTRY.lock.d"
fi

mkdir -p "$dir"/{scripts,results,logs,resources,metadata}
arh_lease_touch "$dir" "arh claim"
printf '%s\n' "$n"
printf 'claimed iteration %s at %s\n' "$n" "$dir" >&2
if [ "$tier" = exploratory ]; then
  printf 'next: arh new -n %s   (a short plan and a journal; no freeze or review needed, sealed inputs stay sealed)\n' "$n" >&2
else
  printf 'next: arh new -n %s   (complete the pre-declaration BEFORE running anything)\n' "$n" >&2
fi
printf 'read: arh context (directives in force, gotchas index); write what this session learns into the project, not private memory\n' >&2
