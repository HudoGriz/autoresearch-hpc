#!/usr/bin/env bash
# Nextflow owns scheduling; this adapter checks the research plan.
set -euo pipefail
. "${ARH_HOME:?}/lib/common.sh"
case "${1-}" in -h|--help) echo 'usage: arh submit WORKFLOW.nf [-n NAME] [--params FILE] [--resume] [-w]'; exit 0 ;; esac
arh_load_project
[ "${ARH_IN_RUNTIME:-0}" != 1 ] || arh_die "run the Nextflow controller on the host for scheduler access"
exec python3 "$ARH_HOME/lib/nextflow.py" "$@"
