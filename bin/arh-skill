#!/usr/bin/env bash
# The research and coding skills installed with the integrations (pinned sources in
# config/dependencies.json: ARIS, Ponytail), under .arh/skills/.
#
#   arh skill          list them by source
#   arh skill NAME     print the path of NAME's SKILL.md, for any harness to read
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
arh_load_project
skills="$ARH_STATE/skills"
[ -n "$(find "$skills" -name SKILL.md -print -quit 2>/dev/null)" ] \
  || arh_die "no skills installed: run $ARH_HOME/scripts/setup-tools.sh $ARH_ROOT"
case "${1-}" in
  -h|--help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
  ""|list) for src in "$skills"/*/; do         # one line per source, so none reads as another's
             names=$(find "$src" -name SKILL.md -printf '%h\n' | xargs -r -n1 basename | sort -u)
             printf '%s (%s): %s\n' "$(basename "$src")" "$(wc -l <<<"$names")" "$(paste -sd' ' - <<<"$names")"
           done ;;
  *) case "$1" in */*|.*) arh_die "a skill name, not a path: $1" ;; esac
     path=$(find "$skills" -path "*/$1/SKILL.md" | sort | head -1)
     [ -n "$path" ] || arh_die "no skill '$1' (arh skill lists them)"
     printf '%s\n' "$path" ;;
esac
