#!/usr/bin/env bash
# Cross-check with a foreign harness.
#
# The point is the *foreign* part. A model reviewing its own output checks
# whether the work looks correctly generated, not whether it is correct — it
# reproduces the reasoning errors it made while generating. So by default the
# verifying harness must belong to a different model family than the producer.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${DL_HOME:?}/lib/common.sh"

role=adversary; n=""; harness=""; same_family=0; dry=0; extra=""
while [ $# -gt 0 ]; do
  case "$1" in
    --role)         role="$2"; shift 2 ;;
    -n|--iteration) n="$2"; shift 2 ;;
    --harness)      harness="$2"; shift 2 ;;
    --same-family)  same_family=1; shift ;;
    --dry-run)      dry=1; shift ;;
    --note)         extra="$2"; shift 2 ;;
    -h|--help) echo 'usage: dl ask --role {adversary|reimplementer|estimand-auditor|gotcha-scanner} -n N [--harness H] [--same-family] [--dry-run]'; exit 0 ;;
    *) dl_die "unexpected argument: $1" ;;
  esac
done
case "$n" in ""|*[!0-9]*) dl_die "iteration must be numeric" ;; esac
case "$role:$harness" in *..*|*/*) dl_die "invalid role or harness" ;; esac
[ -n "$n" ] || dl_die "which iteration? dl ask --role $role -n N"

dl_load_project
dir="$DL_ITERS/iteration$n"
[ -d "$dir" ] || dl_die "no iteration $n"
[ -f "$dir/PREDECLARATION.sha256" ] || dl_die "iteration is not frozen"
[ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(dl_sha256 "$dir/README.md")" ] || dl_die "pre-declaration altered"

roledoc="$DL_HOME/skills/cross-check/roles/$role.md"
[ -f "$roledoc" ] || dl_die "unknown role: $role (see skills/cross-check/roles/)"

producer=$(dl_config_get "$DL_HARN" producer claude)
[ -n "$harness" ] || harness=$(dl_config_get "$DL_HARN" verifier codex)

case "$producer:$harness" in *..*|*/*) dl_die "invalid configured harness name" ;; esac

pfam=$(dl_config_get "$DL_HARN" "harness_${producer}_family" unknown)
vfam=$(dl_config_get "$DL_HARN" "harness_${harness}_family" unknown)
case "$pfam:$vfam" in unknown:*|mixed:*|:*|*:unknown|*:mixed|*:) dl_die "configure concrete producer and verifier model families" ;; esac
if [ "$pfam" = "$vfam" ] && [ "$same_family" = 0 ]; then
  dl_die "producer ($producer/$pfam) and verifier ($harness/$vfam) are the same model family.
       A model does not reliably catch its own reasoning errors. Choose another
       harness, or pass --same-family to record a weaker check that cannot satisfy the results gate."
fi

cmd=$(dl_config_get "$DL_HARN" "harness_${harness}_cmd" "")
[ -n "$cmd" ] || dl_die "no command configured for harness '$harness' (see .dl/config/harnesses.md)"
# Roles that must not see the original implementation. For these the prompt
# carries the frozen DAG without the implementation. Filesystem isolation must
# be provided externally; prompt omission alone is a cooperative boundary.
blind=0
case "$role" in reimplementer) blind=1 ;; esac

dl_guard_path "$dir"
prompt=$(mktemp "$dir/logs/prompt.XXXXXX")
lock=""
cleanup() { rm -f "$prompt"; [ -z "$lock" ] || rmdir "$lock"; }
trap cleanup EXIT
{
  cat "$roledoc"
  printf '\n---\n\n## The work under review\n\n'
  if [ "$blind" = 1 ]; then
    dag="$dir/DAG.md"
    [ -f "$dag" ] || dl_die "role '$role' works from the frozen DAG, and iteration $n has none.
       Run: dl dag init -n $n, complete it, then dl dag freeze -n $n"
    [ -f "$dir/DAG.sha256" ] || dl_die "iteration $n has a DAG but it is not frozen (dl dag freeze -n $n)"
    [ "$(head -1 "$dir/DAG.sha256")" = "$(dl_sha256 "$dag")" ] || dl_die "DAG altered"
    printf 'You are working from the discovery DAG ALONE. The original code is\n'
    printf 'deliberately not provided, and you must not go looking for it: it is\n'
    printf 'under %s/scripts/ and reading it voids this check.\n\n' "$dir"
    printf 'Project root: %s   Iteration: %s\n\n' "$DL_ROOT" "$n"
    printf '### Discovery DAG (frozen %s)\n\n' "$(head -1 "$dir/DAG.sha256")"
    cat "$dag"
    printf '\n### Pre-declaration\n\n'
    [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
    [ -n "$extra" ] && printf '\n### Additional instruction\n\n%s\n' "$extra"
    printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
    printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
    printf '\nThen give, under clear headings: the ambiguities you had to resolve to\n'
    printf 'make the specification runnable; your reproduced value; and — where the\n'
    printf 'object is a set — which elements you got, BY NAME.\n'
  else
  printf 'Project root: %s\nIteration: %s\nDirectory: %s\n\n' "$DL_ROOT" "$n" "$dir"
  printf 'Standing rules every conclusion inherits are in %s/rules/.\n' "$DL_ROOT"
  printf 'Recorded silent failure modes are in %s/GOTCHAS.md.\n\n' "$DL_ROOT"
  printf '### Pre-declaration (written before any result existed)\n\n'
  [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
  report="$dir/results/report/iteration${n}_report.md"
  printf '\n### Report\n\n'
  [ -f "$report" ] && cat "$report" || printf '(no report yet)\n'
  [ -n "$extra" ] && printf '\n### Additional instruction from the operator\n\n%s\n' "$extra"
  printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
  printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
  fi
  printf '\nKeep the response within %s words. Cite specific evidence; do not expand the task.\n' "$(dl_config_get "$DL_HARN" ask_output_words 500)"
} > "$prompt"
max_input=$(dl_config_get "$DL_HARN" ask_max_input_bytes 24000)
max_rounds=$(dl_config_get "$DL_HARN" ask_max_rounds 2)
if [ "$dry" = 0 ]; then
  lock="$dir/.review-lock"
  mkdir "$lock" 2>/dev/null || { lock=""; dl_die "another review is running"; }
fi
cached=$(python3 "$DL_HOME/lib/harness.py" budget "$dir" "$prompt" "$cmd" "$role" "$harness" "$pfam" "$vfam" "$max_input" "$max_rounds" "$extra" "$dry")
if [ -n "$cached" ] && [ "$dry" = 0 ]; then
  printf 'reused unchanged review (no model call): %s\n' "$cached"
  grep -m1 '^VERDICT:' "$cached"
  exit 0
fi

out=$(mktemp "$dir/CROSSCHECK_${role}_${harness}_$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")
mv "$out" "$out.md"
out="$out.md"

if [ "$dry" = 1 ]; then
  rm -f "$out"
  printf '# dry run — would invoke: %s\n\n' "$harness"; cat "$prompt"; exit 0
fi

printf 'cross-check: role=%s harness=%s (%s) vs producer=%s (%s)\n' \
  "$role" "$harness" "$vfam" "$producer" "$pfam" >&2

{
  printf '# Cross-check — iteration %s\n\n' "$n"
  printf '| field | value |\n|---|---|\n'
  printf '| role | `%s` |\n| verifying harness | `%s` (%s) |\n' "$role" "$harness" "$vfam"
  printf '| producing harness | `%s` (%s) |\n| same family | %s |\n' "$producer" "$pfam" \
         "$([ "$same_family" = 1 ] && echo 'yes — WEAKER CHECK' || echo no)"
  printf '| run | %s |\n\n---\n\n' "$(dl_now)"
} > "$out"

timeout_s=$(dl_config_get "$DL_HARN" ask_timeout 900)
# Parse quoted arguments without shell expansion; timeout is portable.
set +e
python3 "$DL_HOME/lib/harness.py" run "$cmd" "$prompt" "$DL_ROOT" "$out" "$timeout_s" "$pfam" "$vfam" "$same_family" "$(dl_config_get "$DL_HARN" ask_max_output_bytes 8000)"
rc=$?
set -e
cp "$prompt" "$out.prompt"
[ -s "$out.err" ] || rm -f "$out.err"

if [ "$rc" -ne 0 ]; then
  dl_warn "harness exited $rc — partial record kept at $out"
  exit "$rc"
fi

printf 'wrote %s\n' "$out"
grep -m1 '^VERDICT:' "$out"
