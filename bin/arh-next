#!/usr/bin/env bash
# Tell the operator what to do next from project state.
set -euo pipefail
. "${ARH_HOME:?}/lib/common.sh"
[ "${1-}" = "--help" ] && { echo 'usage: arh next [-n N]'; exit 0; }
n=""
while [ $# -gt 0 ]; do case "$1" in -n|--iteration) n="$2"; shift 2 ;; *) shift ;; esac; done
arh_load_project
say() { printf '\n  \033[1m%s\033[0m\n' "$1"; }
why() { printf '  %s\n' "$1"; }
iters=$(find "$ARH_ITERS" -maxdepth 1 -type d -name 'iteration*' 2>/dev/null | sed -n 's|.*/iteration\([0-9]\{1,\}\)$|\1|p' | sort -n)
if ! "$ARH_HOME/bin/arh" doctor >/dev/null 2>&1; then printf 'Your configuration does not match this machine.\n'; say "arh doctor"; why "fix what it reports before starting an iteration"; exit 0; fi
if [ -z "$iters" ]; then printf 'This project has no iterations yet.\n'; say 'arh claim -t "the question, stated as a question"'; why "claiming is atomic; never mkdir an iteration by hand"; exit 0; fi
[ -n "$n" ] || n=$(printf '%s\n' $iters | tail -1)
dir="$ARH_ITERS/iteration$n"; [ -d "$dir" ] || arh_die "no iteration $n"
title=$(sed -n 's/.*"title"[ ]*:[ ]*"\(.*\)",\{0,1\}$/\1/p' "$dir/CLAIM.json" 2>/dev/null | head -1)
printf 'Iteration %s — %s\n' "$n" "${title:-(untitled)}"
if [ ! -f "$dir/README.md" ]; then say "arh new -n $n"; why "scaffold the pre-declaration; nothing may run until it is complete"; exit 0; fi
if [ ! -f "$dir/PREDECLARATION.sha256" ]; then say "arh gate predeclare -n $n"; why "complete every section first; the gate freezes the design"; exit 0; fi
if [ "$(head -1 "$dir/PREDECLARATION.sha256")" != "$(arh_sha256 "$dir/README.md")" ]; then printf '\n  \033[1mThe pre-declaration was edited after it was frozen.\033[0m\n'; why "restore it or claim a new iteration for the changed design"; exit 0; fi
if [ -d "$dir/arms" ]; then
  for a in "$dir/arms"/*/; do
    [ -d "$a" ] || continue; id=$(basename "$a")
    if [ ! -f "$a/PREDECLARATION.sha256" ]; then say "arh arm gate -n $n -a $id"; why "arm $id is not frozen yet"; exit 0; fi
    if [ ! -f "$a/FATE" ] && [ -n "$(find "$a/results" -type f 2>/dev/null | head -1)" ]; then say "arh arm fate -n $n -a $id -f CONCLUDED|NULL|INFEASIBLE|KILLED_BY_CONTROL"; why "arm $id has results but no recorded fate"; exit 0; fi
  done
fi
if [ -z "$(find "$dir/results" -type f 2>/dev/null | head -1)" ]; then say "write $dir/scripts/, then: arh submit ..."; why "check acceptance criteria before interpreting anything"; exit 0; fi
report="$dir/results/report/iteration${n}_report.md"
if [ ! -f "$report" ]; then say "write $report"; why "template: $ARH_HOME/templates/iteration/REPORT.md"; exit 0; fi
if ! arh_crosschecks "$dir" | grep -q .; then say "arh ask --role adversary -n $n"; why "cross-check by a different model family before concluding"; exit 0; fi
if [ ! -f "$dir/DAG.md" ]; then say "arh dag init -n $n     (optional, for load-bearing results)"; why "reconstruct the path, then freeze and replicate"; fi
if [ -f "$dir/DAG.md" ] && [ ! -f "$dir/DAG.sha256" ]; then say "arh dag check -n $n && arh dag freeze -n $n"; why "the frozen DAG becomes the blind-replication specification"; exit 0; fi
if [ -f "$dir/DAG.sha256" ] && [ ! -d "$ARH_VERIFY/replication_it$n" ]; then say "arh replicate -n $n --agents 3"; why "agents re-implement from the DAG without the original code"; exit 0; fi
if ! "$ARH_HOME/bin/arh" gate results -n "$n" >/dev/null 2>&1; then say "arh gate results -n $n"; why "it is currently failing — run it to see what remains"; exit 0; fi
say "arh ledger render && arh ledger check"; why "record the conclusion and then claim the next question"
