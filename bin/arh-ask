#!/usr/bin/env bash
# Cross-check with a foreign harness.
#
# The point is the *foreign* part. A model reviewing its own output checks
# whether the work looks correctly generated, not whether it is correct — it
# reproduces the reasoning errors it made while generating. So by default the
# verifying harness must belong to a different model family than the producer.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"

role=adversary; n=""; harness=""; same_family=0; dry=0; extra=""
while [ $# -gt 0 ]; do
  case "$1" in
    --role)         role="$2"; shift 2 ;;
    -n|--iteration) n="$2"; shift 2 ;;
    --harness)      harness="$2"; shift 2 ;;
    --same-family)  same_family=1; shift ;;
    --dry-run)      dry=1; shift ;;
    --note)         extra="$2"; shift 2 ;;
    -h|--help) echo 'usage: arh ask --role {adversary|reimplementer|estimand-auditor|gotcha-scanner} -n N [--harness H] [--same-family] [--dry-run] [--note TEXT]
exit 75: provider usage/rate limit or authentication; 77: provider refused the content. Neither spends a review round.'; exit 0 ;;
    *) arh_die "unexpected argument: $1" ;;
  esac
done
case "$n" in ""|*[!0-9]*) arh_die "iteration must be numeric" ;; esac
case "$role:$harness" in *..*|*/*) arh_die "invalid role or harness" ;; esac
[ -n "$n" ] || arh_die "which iteration? arh ask --role $role -n N"

arh_load_project
dir="$ARH_ITERS/iteration$n"
[ -d "$dir" ] || arh_die "no iteration $n"
[ -f "$dir/PREDECLARATION.sha256" ] || arh_die "iteration is not frozen"
[ "$(head -1 "$dir/PREDECLARATION.sha256")" = "$(arh_sha256 "$dir/README.md")" ] || arh_die "pre-declaration altered"

roledoc="$ARH_HOME/skills/cross-check/roles/$role.md"
[ -f "$roledoc" ] || arh_die "unknown role: $role (see skills/cross-check/roles/)"

# Standing rules are enforced again by `arh gate results`, but only after the review. A report
# that fails them then has to be edited, which invalidates the hash-bound review and costs a
# round. Check first, while fixing the report is still free.
report_file="$dir/results/report/iteration${n}_report.md"
if [ "$role" != reimplementer ] && [ -f "$report_file" ]; then
  if ! rule_out=$("$ARH_HOME/bin/arh" gate rules "$report_file" 2>&1); then
    printf '%s\n' "$rule_out" | grep -E 'FAIL' >&2 || true
    arh_die "the report fails the standing rules; fix it before review (arh gate rules ${report_file#"$ARH_ROOT"/}).
       Editing a report after its review invalidates the review."
  fi
fi

producer=$(arh_config_get "$ARH_HARN" producer claude)
case "$producer" in *..*|*/*) arh_die "invalid configured harness name" ;; esac
pfam=$(arh_config_get "$ARH_HARN" "harness_${producer}_family" unknown)

# Why harness $1 cannot give this review; nothing when it can.
ineligible() {
  local fam
  case "$1" in ""|*..*|*/*) echo "invalid configured harness name"; return ;; esac
  fam=$(arh_config_get "$ARH_HARN" "harness_${1}_family" unknown)
  case "$pfam:$fam" in unknown:*|mixed:*|:*|*:unknown|*:mixed|*:) echo "configure concrete producer and verifier model families"; return ;; esac
  if [ "$pfam" = "$fam" ] && [ "$same_family" = 0 ]; then
    echo "producer ($producer/$pfam) and verifier ($1/$fam) are the same model family.
       A model does not reliably catch its own reasoning errors. Choose another
       harness, or pass --same-family to record a weaker check that cannot satisfy the results gate."
    return
  fi
  [ -n "$(arh_config_get "$ARH_HARN" "harness_${1}_cmd" "")" ] \
    || echo "no command configured for harness '$1' (see .arh/config/harnesses.md)"
}

# An explicit --harness is used alone. Otherwise the configured verifier goes first, and each
# verifier_fallback is tried in turn only after a content-policy refusal (exit 77): waiting does
# not change such a refusal, but another model family may still review the work.
if [ -n "$harness" ]; then candidates=$harness
else candidates="$(arh_config_get "$ARH_HARN" verifier codex) $(arh_config_get "$ARH_HARN" verifier_fallback "")"; fi
primary=${candidates%% *}
why=$(ineligible "$primary")
[ -z "$why" ] || arh_die "$why"
# Roles that must not see the original implementation. For these the prompt
# carries the frozen DAG without the implementation. Filesystem isolation must
# be provided externally; prompt omission alone is a cooperative boundary.
blind=0
case "$role" in reimplementer) blind=1 ;; esac

arh_guard_path "$dir"
prompt=$(mktemp "$dir/logs/prompt.XXXXXX")
lock=""
cleanup() { rm -f "$prompt"; [ -z "$lock" ] || { rm -f "$lock/owner.json"; rmdir "$lock"; }; }
trap cleanup EXIT
{
  cat "$roledoc"
  printf '\n---\n\n## The work under review\n\n'
  if [ "$blind" = 1 ]; then
    dag="$dir/DAG.md"
    [ -f "$dag" ] || arh_die "role '$role' works from the frozen DAG, and iteration $n has none.
       Run: arh dag init -n $n, complete it, then arh dag freeze -n $n"
    [ -f "$dir/DAG.sha256" ] || arh_die "iteration $n has a DAG but it is not frozen (arh dag freeze -n $n)"
    [ "$(head -1 "$dir/DAG.sha256")" = "$(arh_sha256 "$dag")" ] || arh_die "DAG altered"
    printf 'You are working from the discovery DAG ALONE. The original code is\n'
    printf 'deliberately not provided, and you must not go looking for it: it is\n'
    printf 'under %s/scripts/ and reading it voids this check.\n\n' "$dir"
    printf 'Project root: %s   Iteration: %s\n\n' "$ARH_ROOT" "$n"
    printf '### Discovery DAG (frozen %s)\n\n' "$(head -1 "$dir/DAG.sha256")"
    cat "$dag"
    printf '\n### Pre-declaration\n\n'
    [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
    [ -n "$extra" ] && printf '\n### Additional instruction\n\n%s\n' "$extra"
    printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
    printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
    printf '\nThen give, under clear headings: the ambiguities you had to resolve to\n'
    printf 'make the specification runnable; your reproduced value; and — where the\n'
    printf 'object is a set — which elements you got, BY NAME.\n'
  else
  printf 'Project root: %s\nIteration: %s\nDirectory: %s\n\n' "$ARH_ROOT" "$n" "$dir"
  printf 'Standing rules every conclusion inherits are in %s/rules/.\n' "$ARH_ROOT"
  printf 'Recorded silent failure modes are in %s/GOTCHAS.md.\n\n' "$ARH_ROOT"
  printf '### Pre-declaration (written before any result existed)\n\n'
  [ -f "$dir/README.md" ] && cat "$dir/README.md" || printf '(none)\n'
  report="$dir/results/report/iteration${n}_report.md"
  printf '\n### Report\n\n'
  [ -f "$report" ] && cat "$report" || printf '(no report yet)\n'
  [ -n "$extra" ] && printf '\n### Additional instruction from the operator\n\n%s\n' "$extra"
  printf '\nDo not use the declared prediction as evidence for your verdict.\n'
  printf '\n---\n\nWrite your findings as Markdown. Begin with a single line:\n'
  printf 'VERDICT: SOUND | QUALIFIED | UNSOUND\n'
  fi
  printf '\nKeep the response within %s words. Cite specific evidence; do not expand the task.\n' "$(arh_config_get "$ARH_HARN" ask_output_words 500)"
} > "$prompt"
max_input=$(arh_config_get "$ARH_HARN" ask_max_input_bytes 24000)
max_rounds=$(arh_config_get "$ARH_HARN" ask_max_rounds 2)
if [ "$dry" = 1 ]; then
  python3 "$ARH_HOME/lib/harness.py" budget "$dir" "$prompt" "$(arh_config_get "$ARH_HARN" "harness_${primary}_cmd" "")" \
    "$role" "$primary" "$pfam" "$(arh_config_get "$ARH_HARN" "harness_${primary}_family" unknown)" \
    "$max_input" "$max_rounds" "$extra" 1 >/dev/null
  printf '# dry run — would invoke: %s\n\n' "$primary"; cat "$prompt"; exit 0
fi

# The lock records its owner, so `arh wait` can tell a running review from one whose process died,
# and a lock left by a dead process on this host is reclaimed instead of refusing every later review.
lock="$dir/.review-lock"
if ! held=$(python3 "$ARH_HOME/lib/locks.py" acquire "$lock" "$$" "review lock" 2>&1); then
  lock=""; arh_die "another review is running${held#held}"
fi
[ -z "$held" ] || printf '%s\n' "$held" >&2

timeout_s=$(arh_config_get "$ARH_HARN" ask_timeout 900)
rc=0; tried=""
for h in $candidates; do
  if [ "$h" != "$primary" ]; then
    why=$(ineligible "$h")
    if [ -n "$why" ]; then arh_warn "fallback verifier '$h' skipped: ${why%%$'\n'*}"; continue; fi
    arh_warn "trying fallback verifier '$h'"
  fi
  vfam=$(arh_config_get "$ARH_HARN" "harness_${h}_family" unknown)
  cmd=$(arh_config_get "$ARH_HARN" "harness_${h}_cmd" "")
  cached=$(python3 "$ARH_HOME/lib/harness.py" budget "$dir" "$prompt" "$cmd" "$role" "$h" "$pfam" "$vfam" "$max_input" "$max_rounds" "$extra" 0)
  if [ -n "$cached" ]; then
    printf 'reused unchanged review (no model call): %s\n' "$cached"
    grep -m1 '^VERDICT:' "$cached"
    exit 0
  fi

  out=$(mktemp "$dir/CROSSCHECK_${role}_${h}_$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")
  mv "$out" "$out.md"
  out="$out.md"
  printf 'cross-check: role=%s harness=%s (%s) vs producer=%s (%s)\n' \
    "$role" "$h" "$vfam" "$producer" "$pfam" >&2
  {
    printf '# Cross-check — iteration %s\n\n' "$n"
    printf '| field | value |\n|---|---|\n'
    printf '| role | `%s` |\n| verifying harness | `%s` (%s) |\n' "$role" "$h" "$vfam"
    printf '| producing harness | `%s` (%s) |\n| same family | %s |\n' "$producer" "$pfam" \
           "$([ "$same_family" = 1 ] && echo 'yes — WEAKER CHECK' || echo no)"
    printf '| run | %s |\n\n---\n\n' "$(arh_now)"
  } > "$out"

  # Parse quoted arguments without shell expansion; timeout is portable.
  set +e
  python3 "$ARH_HOME/lib/harness.py" run "$cmd" "$prompt" "$ARH_ROOT" "$out" "$timeout_s" "$pfam" "$vfam" "$same_family" \
    "$(arh_config_get "$ARH_HARN" ask_max_output_bytes 8000)" "$(arh_config_get "$ARH_HARN" "harness_${h}_version_cmd" "")"
  rc=$?
  set -e
  cp "$prompt" "$out.prompt"
  [ -s "$out.err" ] || rm -f "$out.err"
  tried="$tried $h"
  [ "$rc" -eq 77 ] || break
  arh_warn "verifier '$h' refused to review this content (content policy); record kept at $out"
done

if [ "$rc" -eq 75 ]; then
  arh_warn "verifier unavailable: the provider refused the call (usage or rate limit, or authentication).
       This attempt did not consume a review round; record kept at $out
       Wait for the reset the provider states (\"provider said\" above), then run the same arh ask again."
  exit "$rc"
fi
if [ "$rc" -eq 77 ]; then
  arh_warn "no verifier would review this content (tried:$tried): refused on content-policy grounds.
       This did not consume a review round. Waiting will not change it. Configure a harness from
       another model family as verifier_fallback in .arh/config/harnesses.md, or record the refusal
       as what blocks the iteration."
  exit "$rc"
fi
if [ "$rc" -ne 0 ]; then
  arh_warn "harness exited $rc — partial record kept at $out"
  exit "$rc"
fi

printf 'wrote %s\n' "$out"
grep -m1 '^VERDICT:' "$out"
