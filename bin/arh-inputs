#!/usr/bin/env bash
# Check that declared inputs are whole, and keep the result where run receipts can cite it.
#
#   arh inputs check [--deep] [--force] [PATH...]   every declared immutable input, or the PATHs given
#   arh inputs list                                 the latest result per checked file
#
# End-of-file markers of BGZF (BAM, BCF, .vcf.gz, .bgz, indices) and CRAM 3 files are read in
# constant time; --deep also decompresses gzip files. arh submit records the latest results in its
# receipt and warns when a declared input failed.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${ARH_HOME:?}/lib/common.sh"
case "${1-}" in
  -h|--help|"") sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
sub="$1"; shift
arh_load_project
case "$sub" in
  check) exec python3 "$ARH_HOME/lib/inputs.py" check "$ARH_ROOT" "$@" ;;
  list)
    exec python3 - "$ARH_ROOT" <<'PY'
import sys
sys.path.insert(0, __import__('os').environ['ARH_HOME'] + '/lib')
from inputs import history
rows = history(sys.argv[1])
for path, r in sorted(rows.items()):
    print(f"{'ok  ' if r.get('ok') else 'FAIL'} {r.get('time', '?')}  {path}: {r.get('detail', '')}")
if not rows:
    print('(nothing checked yet — arh inputs check)')
PY
    ;;
  *) arh_die "unknown: $sub (arh inputs check | list)" ;;
esac
