#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib/common.sh
. "${DL_HOME:?}/lib/common.sh"

target="${1:-$PWD}"
[ "${1-}" = "--help" ] && { echo "usage: dl init [dir]"; exit 0; }
mkdir -p "$target"
target=$(cd "$target" && pwd)

[ -d "$target/.dl" ] && dl_die "already a discovery-loop project: $target"

mkdir -p "$target/.dl/config" "$target/rules"
cp "$DL_HOME/config/site.md"      "$target/.dl/config/site.md"
cp "$DL_HOME/config/project.md"   "$target/.dl/config/project.md"
cp "$DL_HOME/config/harnesses.md" "$target/.dl/config/harnesses.md"
cp "$DL_HOME"/config/rules/*.md   "$target/rules/"

DL_PROJ="$target/.dl/config/project.md"
iters=$(dl_config_get "$DL_PROJ" iterations_dir iterations)
verif=$(dl_config_get "$DL_PROJ" verification_dir verification)
ledger=$(dl_config_get "$DL_PROJ" ledger PROGRESS.md)
mkdir -p "$target/$iters" "$target/$verif"

printf 'iteration\tagent\tclaimed\tstatus\ttitle\n' > "$target/.dl/registry.tsv"

sed -e "s|{{PROJECT}}|$(basename "$target")|g" -e "s|{{DATE}}|$(dl_today)|g" \
  "$DL_HOME/templates/PROGRESS.md" > "$target/$ledger"
cp "$DL_HOME/templates/GOTCHAS.md" "$target/GOTCHAS.md"
cp "$DL_HOME/AGENTS.md" "$target/AGENTS.md"
ln -sf AGENTS.md "$target/CLAUDE.md"

cat > "$target/.dl/VERSION" <<EOF
protocol = 0.1.0
created  = $(dl_now)
by       = $(dl_agent_name)
EOF

printf 'Initialised discovery-loop project at %s\n\n' "$target"
printf '  %-26s the record — read this first\n' "$ledger"
printf '  %-26s harness contract (CLAUDE.md symlinks here)\n' AGENTS.md
printf '  %-26s silent failure modes, as executable assertions\n' GOTCHAS.md
printf '  %-26s standing rules every iteration inherits\n' rules/
printf '  %-26s edit these before your first iteration\n' .dl/config/
printf '\nNext: edit .dl/config/site.md, then  dl claim -t "your first question"\n'
